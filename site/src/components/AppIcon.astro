---
import { media, type App } from '../lib/content';

interface Props {
  app: App;
  size?: number;
}
const { app, size = 64 } = Astro.props;
const src = media(app.icon_path);
---

{
  src ? (
    <img class="app-icon" src={src} alt="" width={size} height={size} loading="lazy" style={`--size:${size}px`} />
  ) : (
    <span class="app-icon app-icon-fallback" aria-hidden="true" style={`--size:${size}px;--accent:${app.accent_color}`}>
      {app.name.charAt(0)}
    </span>
  )
}

<style>
  .app-icon {
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.225);
    flex-shrink: 0;
  }
  .app-icon-fallback {
    display: inline-grid;
    place-items: center;
    color: #fff;
    font-weight: 600;
    font-size: calc(var(--size) * 0.46);
    letter-spacing: -0.02em;
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 70%, #fff), var(--accent) 55%, color-mix(in srgb, var(--accent) 75%, #000));
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  }
</style>
