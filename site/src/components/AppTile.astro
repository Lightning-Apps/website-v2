---
import AppIcon from './AppIcon.astro';
import { getPlans, media, type App } from '../lib/content';
import { hasPricing, priceLabel } from '../lib/pricing';
import { localizePath, useTranslations, type Locale } from '../i18n/ui';
import { pick } from '@lightning/shared';

interface Props {
  app: App;
  lang: Locale;
}
const { app, lang } = Astro.props;
const t = useTranslations(lang);
const hero = media(app.hero_path);
const detail = localizePath(lang, `apps/${app.slug}`);
const plans = await getPlans(app.uuid);
const price = hasPricing(app) ? priceLabel(app, plans, lang) : null;
---

<article class="tile reveal" style={`--accent:${app.accent_color}`}>
  <div class="tile-text">
    <AppIcon app={app} size={72} />
    <h3 class="headline-m">{app.name}</h3>
    <p class="tile-tagline">{pick(app, 'tagline', lang)}</p>
    <span class:list={['badge', `badge-${app.status}`]}>{pick(app, 'release_label', lang) || t(`status.${app.status}`)}</span>
    {price && <p class="tile-price">{price}</p>}
    <div class="links tile-links">
      <a class="chevron-link" href={detail}>{t('cta.learnMore')}<span class="visually-hidden"> – {app.name}</span></a>
      {app.app_store_url && <a class="chevron-link" href={app.app_store_url} rel="noopener">{t('cta.download')}</a>}
    </div>
  </div>
  <div class="tile-visual" aria-hidden="true">
    {hero ? <img src={hero} alt="" loading="lazy" /> : <div class="tile-glow"></div>}
  </div>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    padding: 48px 32px 0;
    border-radius: var(--radius-l);
    background: var(--bg-alt);
    text-align: center;
    overflow: hidden;
  }
  :global(.section-alt) .tile { background: var(--bg-elevated); }
  .tile-text { display: grid; justify-items: center; gap: 10px; position: relative; z-index: 1; }
  .tile-text h3 { margin-top: 8px; }
  .tile-tagline { font-size: 21px; line-height: 1.24; }
  .tile-links { margin-top: 8px; font-size: 17px; }
  .tile-price { font-size: 14px; color: var(--text-secondary); }
  .tile-visual { flex: 1; display: flex; align-items: flex-end; justify-content: center; margin-top: 28px; }
  .tile-visual img { max-height: 280px; width: auto; object-fit: contain; }
  .tile-glow {
    width: 120%;
    height: 220px;
    margin-bottom: -60px;
    background: radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--accent) 45%, transparent), transparent 70%);
  }
</style>
