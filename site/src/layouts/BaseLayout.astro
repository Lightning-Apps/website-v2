---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, localizePath, switchLocalePath, useTranslations, withBase, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  image?: string | null;
}
const { lang, title, description, image } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} – Lightning Apps` : 'Lightning Apps';
const desc = description ?? t('home.studioText');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Set by the dashboard when it builds a preview with unpublished changes.
const previewLabel = process.env.PREVIEW_LABEL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'de'), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Lightning Apps Newsroom" href={localizePath(lang, 'rss.xml').replace(/\/$/, '')} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    {previewLabel && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lightning Apps" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Navbar lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {previewLabel && <div class="preview-badge" role="status">{previewLabel}</div>}

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
