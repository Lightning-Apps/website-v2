---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppIcon from '../../../components/AppIcon.astro';
import NewsCard from '../../../components/NewsCard.astro';
import AppPricing from '../../../components/AppPricing.astro';
import BetaDialog from '../../../components/BetaDialog.astro';
import { betaUrl, getAllApps, getFeatures, getNews, getPlans, media, renderMarkdown, type App } from '../../../lib/content';
import { hasPricing, priceLabel } from '../../../lib/pricing';
import { LOCALES, localizePath, useTranslations, type Locale } from '../../../i18n/ui';
import { activePeriod, pick } from '@lightning/shared';

export async function getStaticPaths() {
  // Archived apps keep their page (old links keep working) and show a notice.
  const apps = await getAllApps();
  return LOCALES.flatMap((lang) => apps.map((app) => ({ params: { lang, slug: app.slug }, props: { app } })));
}

const { app } = Astro.props as { app: App };
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const [features, plans, news] = await Promise.all([getFeatures(app.uuid), getPlans(app.uuid), getNews()]);
const showPricing = hasPricing(app);
const price = showPricing ? priceLabel(app, plans, lang) : null;
const related = news.filter((n) => n.related_app_id === app.uuid).slice(0, 3);
const hero = media(app.hero_path);
const beta = betaUrl(app);
const body = pick(app, 'body', lang);
const period = activePeriod(app, lang);
const archiveNote = pick(app, 'archive_note', lang);
// Archived apps show "Archiviert · 2021–2024" instead of their release status.
const statusLabel = app.archived
  ? [t('archive.badge'), period].filter(Boolean).join(' · ')
  : pick(app, 'release_label', lang) || t(`status.${app.status}`);

// Search engines: app with its price and plans (schema.org).
const structured = showPricing && {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: pick(app, 'description', lang) || pick(app, 'tagline', lang),
  applicationCategory: 'MobileApplication',
  operatingSystem: app.platforms.map((p) => p.name).join(', ') || 'iOS',
  url: new URL(Astro.url.pathname, Astro.site).href,
  ...(app.app_store_url && { downloadUrl: app.app_store_url }),
  offers: [
    { '@type': 'Offer', price: (app.price_eur ?? 0).toFixed(2), priceCurrency: 'EUR' },
    ...plans.map((p) => ({ '@type': 'Offer', name: pick(p, 'name', lang), price: p.price_eur.toFixed(2), priceCurrency: 'EUR' })),
  ],
};
---

<BaseLayout lang={lang} title={app.name} description={pick(app, 'description', lang)} image={hero}>
  <div class="subnav" style={`--accent:${app.accent_color}`}>
    <div class="container-wide subnav-inner">
      <a class="subnav-title" href="#top">{app.name}</a>
      <div class="subnav-end">
        <a class="subnav-link" href="#overview">{t('app.overview')}</a>
        {features.length > 0 && <a class="subnav-link" href="#features">{t('app.features')}</a>}
        {showPricing && <a class="subnav-link" href="#pricing">{t('app.pricing')}</a>}
        {price && <span class="subnav-price">{price}</span>}
        {
          app.app_store_url ? (
            <a class="button button-small" href={app.app_store_url} rel="noopener">{t('cta.download')}</a>
          ) : beta ? (
            <a class="button button-small" href={beta} rel="noopener">{t('beta.join')}</a>
          ) : (
            <span class="button button-small is-disabled">{statusLabel}</span>
          )
        }
      </div>
    </div>
  </div>

  {
    app.archived && (
      <aside class="archive-banner">
        <div class="container-wide archive-banner-inner">
          <p>
            <strong>{t('archive.banner')}</strong>
            {period && <span> {t('archive.active')} {period}.</span>}
            {archiveNote && <span> {archiveNote}</span>}
          </p>
          <a class="chevron-link" href={localizePath(lang, 'archive')}>{t('nav.archive')}</a>
        </div>
      </aside>
    )
  }

  <section class="app-hero" id="top" style={`--accent:${app.accent_color}`}>
    <div class="container hero-text">
      <AppIcon app={app} size={120} />
      <h1 class="headline-xl">{app.name}</h1>
      <p class="hero-tagline">{pick(app, 'tagline', lang)}</p>
      <span class="badges">
        <span class:list={['badge', !app.archived && `badge-${app.status}`]}>{statusLabel}</span>
        {beta && <span class="badge badge-beta">{t('beta.badge')}</span>}
      </span>
      {
        app.app_store_url ? (
          <a class="button" href={app.app_store_url} rel="noopener">{t('cta.download')}</a>
        ) : (
          beta && <a class="button" href={beta} rel="noopener">{t('beta.join')}</a>
        )
      }
      {
        beta && (
          <span class="links beta-links">
            {app.app_store_url && <a class="chevron-link" href={beta} rel="noopener">{t('beta.join')}</a>}
            <button class="chevron-link beta-qr-link" type="button" data-beta-qr aria-haspopup="dialog">{t('beta.showQr')}</button>
          </span>
        )
      }
      {price && <a class="hero-price" href="#pricing">{price}</a>}
    </div>
    <div class="hero-visual container-wide" aria-hidden="true">
      {hero ? <img src={hero} alt="" /> : <div class="hero-glow" />}
    </div>
  </section>

  <section class="section section-alt" id="overview">
    <div class="container overview reveal">
      <p class="lead overview-lead">{pick(app, 'description', lang)}</p>
      {body && <div class="prose" set:html={renderMarkdown(body)} />}
    </div>
  </section>

  {
    features.length > 0 && (
      <section class="section" id="features">
        <div class="container-wide">
          <h2 class="headline-l center section-head">{t('app.features')}</h2>
          <div class="features">
            {features.map((f, i) => {
              const img = media(f.image_path);
              return (
                <article class:list={['feature', 'reveal', { flip: i % 2 === 1 }]} style={`--accent:${app.accent_color}`}>
                  <div class="feature-media" aria-hidden={img ? undefined : 'true'}>
                    {img ? <img src={img} alt={pick(f, 'title', lang)} loading="lazy" /> : <div class="feature-placeholder"><span>{String(i + 1).padStart(2, '0')}</span></div>}
                  </div>
                  <div class="feature-text">
                    <h3 class="headline-m">{pick(f, 'title', lang)}</h3>
                    <p class="lead">{pick(f, 'text', lang)}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {showPricing && <AppPricing app={app} plans={plans} lang={lang} />}

  {
    app.platforms.length > 0 && (
      <section class="section section-alt" id="platforms">
        <div class="container">
          <h2 class="headline-l center section-head">{t('app.platforms')}</h2>
          <ul class="platforms reveal">
            {app.platforms.map((p) => (
              <li class:list={['platform', `state-${p.state}`]}>
                <span class="platform-name">{p.name}</span>
                <span class="platform-state">{t(`platform.${p.state}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section">
        <div class="container-wide">
          <h2 class="headline-m center section-head">{t('app.relatedNews')} {app.name}</h2>
          <div class="grid grid-3">
            {related.map((item) => <NewsCard item={item} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }
  {beta && <BetaDialog app={app} url={beta} lang={lang} />}
  {structured && <script type="application/ld+json" set:html={JSON.stringify(structured)} />}
</BaseLayout>

<style>
  .subnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 30;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .subnav-inner { display: flex; align-items: center; justify-content: space-between; height: 52px; gap: 16px; }
  .subnav-title { color: var(--text); font-size: 21px; font-weight: 600; letter-spacing: -0.02em; }
  .subnav-title:hover { text-decoration: none; }
  .subnav-end { display: flex; align-items: center; gap: 20px; font-size: 12px; }
  .subnav-link { color: var(--text); opacity: 0.8; }
  .subnav .button { background: var(--accent); }
  .is-disabled { background: var(--text-tertiary) !important; cursor: default; }
  .subnav-price { color: var(--text-secondary); }
  @media (max-width: 600px) { .subnav-link, .subnav-price { display: none; } }

  .archive-banner { background: var(--bg-alt); border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
  .archive-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 14px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .archive-banner strong { color: var(--text); font-weight: 600; }
  .archive-banner a { white-space: nowrap; }

  .app-hero { padding-top: clamp(56px, 9vw, 96px); text-align: center; overflow: hidden; }
  .hero-text { display: grid; justify-items: center; gap: 14px; }
  .hero-text h1 { margin-top: 12px; }
  .hero-tagline { font-size: clamp(24px, 3.4vw, 32px); font-weight: 500; }
  .hero-text .button { background: var(--accent); margin-top: 10px; }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .beta-links { font-size: 17px; }
  .beta-qr-link { padding: 0; border: 0; background: none; font: inherit; color: var(--link); cursor: pointer; }
  /* On a phone the link itself opens TestFlight; a code to scan only helps on other devices. */
  @media (hover: none) and (pointer: coarse) { .beta-qr-link { display: none; } }
  .hero-price { font-size: 14px; color: var(--text-secondary); }
  .hero-price:hover { color: var(--text); }
  .hero-visual { display: flex; justify-content: center; margin-top: 48px; }
  .hero-visual img { max-height: 560px; width: auto; }
  .hero-glow {
    width: min(900px, 100%);
    height: clamp(200px, 28vw, 340px);
    background: radial-gradient(ellipse 60% 75% at 50% 100%, color-mix(in srgb, var(--accent) 60%, transparent), transparent 72%);
  }

  .overview { max-width: 760px; display: grid; gap: 32px; }
  .overview-lead { color: var(--text); font-size: clamp(24px, 3.2vw, 32px); font-weight: 600; line-height: 1.2; }

  .features { display: grid; gap: clamp(48px, 8vw, 96px); }
  .feature { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .feature.flip .feature-media { order: 2; }
  .feature-text { display: grid; gap: 16px; }
  .feature-media img { border-radius: var(--radius-l); }
  .feature-placeholder {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 60%),
      var(--bg-alt);
  }
  .feature-placeholder span { font-size: 96px; font-weight: 700; color: color-mix(in srgb, var(--accent) 60%, transparent); letter-spacing: -0.04em; }
  @media (max-width: 833px) {
    .feature { grid-template-columns: 1fr; }
    .feature.flip .feature-media { order: 0; }
  }

  .platforms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }
  .platform {
    display: grid;
    gap: 4px;
    padding: 24px;
    border-radius: var(--radius-m);
    background: var(--bg-elevated);
    text-align: center;
  }
  .platform-name { font-size: 24px; font-weight: 600; }
  .platform-state { font-size: 14px; color: var(--text-secondary); }
  .state-available .platform-state { color: #1a8f3a; }
  @media (prefers-color-scheme: dark) { .state-available .platform-state { color: #30d158; } }
  .state-planned { opacity: 0.7; }
</style>
