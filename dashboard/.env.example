# Local: copy to dashboard/.env
# Home server (Docker): copy to dashboard/.env.server

# Supabase → Project Settings → API
SUPABASE_URL=https://dxftytekcnsmpbxxtxdx.supabase.co
# The secret key (sb_secret_...). Never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare → Worker → Settings → Builds → Deploy Hooks
CF_DEPLOY_HOOK_URL=
# Public website URL ("Website öffnen" and the live status from /build.json)
SITE_URL=http://localhost:4321

# --- Optional: build progress in the overview ---
# Account ID: Cloudflare dashboard → Account home → ⋯ next to the account name → Copy account ID
CF_ACCOUNT_ID=
# User API token (My Profile → API Tokens) with: Workers Builds Configuration – Read, Workers Scripts – Read
CF_API_TOKEN=
# Name of the Worker (wrangler.jsonc → name)
CF_WORKER_NAME=website-v2

# --- Only needed on the server ---
# Create both values with: npm run hash-password -w dashboard
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
# Addresses you open the dashboard with (host:port, comma-separated), e.g.
# 192.168.1.20:4322,ubuntu-vm.local:4322,dashboard.home.lan
DASHBOARD_ALLOWED_HOSTS=

# --- Scheduled releases ---
# "on" publishes due scheduled releases automatically. The Docker image sets it already;
# locally it stays off, so the dashboard on the server does it.
# DASHBOARD_SCHEDULER=on
