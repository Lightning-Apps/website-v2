---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getEntity } from '../../lib/entities';
import { configError, db, formatDateTime, mediaPublicUrl } from '../../lib/server';

const entity = getEntity(Astro.params.entity);
if (!entity || entity.nested) return new Response('Not found', { status: 404 });

const setupError = configError();
let rows: Record<string, any>[] = [];
let loadError: string | null = null;
if (!setupError) {
  const { data, error } = await db().from(entity.table).select('*').order(entity.orderBy.column, { ascending: entity.orderBy.ascending });
  rows = data ?? [];
  loadError = error?.message ?? null;
}
const deleted = Astro.url.searchParams.get('deleted');
const thumbField = entity.key === 'apps' ? 'icon_path' : entity.key === 'news' ? 'cover_path' : null;
---

<DashboardLayout title={entity.label}>
  <div class="page-head">
    <h1>{entity.label}</h1>
    <a class="btn btn-primary" href={`/${entity.key}/new`}>+ {entity.singular} anlegen</a>
  </div>

  {setupError && <p class="notice notice-error">{setupError}</p>}
  {loadError && <p class="notice notice-error">Fehler beim Laden: {loadError}</p>}
  {deleted && <p class="notice notice-ok">„{deleted}“ wurde gelöscht.</p>}

  <div class="panel">
    {
      rows.length === 0 ? (
        <p class="muted">Noch keine Einträge.</p>
      ) : (
        <table>
          <thead>
            <tr>
              {thumbField && <th />}
              <th>Titel</th>
              <th>{entity.key === 'news' ? 'Datum' : 'Reihenfolge'}</th>
              <th>Status</th>
              <th>Zuletzt geändert</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const thumb = thumbField ? mediaPublicUrl(row[thumbField]) : null;
              return (
                <tr>
                  {thumbField && <td>{thumb ? <img class="thumb" src={thumb} alt="" /> : <span class="thumb" style="display:inline-block" />}</td>}
                  <td>
                    <a href={`/${entity.key}/${row.id}`}><strong>{row[entity.titleField] || '(ohne Titel)'}</strong></a>
                    {row.slug && <div class="muted">/{row.slug}</div>}
                  </td>
                  <td>{entity.key === 'news' ? row.published_at : row.sort_order}</td>
                  <td>
                    <span class:list={['pill', row.published ? 'pill-published' : 'pill-draft']}>{row.published ? 'Veröffentlicht' : 'Entwurf'}</span>
                    {row.featured && <span class="pill pill-published">Startseite</span>}
                  </td>
                  <td class="muted">{formatDateTime(row.updated_at)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </div>
</DashboardLayout>
