---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import EntityForm from '../../components/EntityForm.astro';
import ChildList from '../../components/ChildList.astro';
import Sortable from '../../components/Sortable.astro';
import { APP_CHILDREN, getEntity } from '../../lib/entities';
import { configError, db, formToRow } from '../../lib/server';

const entity = getEntity(Astro.params.entity);
if (!entity) return new Response('Not found', { status: 404 });

const setupError = configError();
const id = Astro.params.id!;
const isNew = id === 'new';
let row: Record<string, any> = {};
let error: string | null = setupError;
let saved = Astro.url.searchParams.get('saved') === '1';
// Features and plans can be opened from their app or from their own list; `back` remembers which (local paths only).
const backParam = Astro.url.searchParams.get('back');
const back = backParam && backParam.startsWith('/') && !backParam.startsWith('//') ? backParam : null;
const isChild = entity.parent === 'apps';
const backTo = isChild ? (appId: string) => back ?? `/apps/${appId}` : () => `/${entity.key}/`;
const keepBack = back ? `&back=${encodeURIComponent(back)}` : '';

if (!setupError && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  try {
    if (action === 'delete' && !isNew) {
      // Images stay in storage until the next publish, so the deletion can still be discarded.
      const { data: existing } = await db().from(entity.table).select('*').eq('id', id).single();
      const { error: delError } = await db().from(entity.table).delete().eq('id', id);
      if (delError) throw new Error(delError.message);
      const name = existing?.[entity.titleField] ?? entity.singular;
      const target = isChild && !back ? backTo(existing?.app_id) : `${backTo('')}?deleted=${encodeURIComponent(name)}`;
      return Astro.redirect(target, 303);
    }
    const values = await formToRow(entity, form);
    const query = isNew
      ? db().from(entity.table).insert(values).select().single()
      : db().from(entity.table).update(values).eq('id', id).select().single();
    const { data, error: saveError } = await query;
    if (saveError) throw new Error(saveError.code === '23505' ? 'Dieser Slug ist schon vergeben.' : saveError.message);
    return Astro.redirect(`/${entity.key}/${data.id}?saved=1${keepBack}`, 303);
  } catch (e) {
    error = (e as Error).message;
    // Re-show what was typed (images and platforms are re-read from the database below).
    row = Object.fromEntries([...form.entries()].filter(([, v]) => typeof v === 'string'));
    for (const f of entity.fields) if (f.type === 'checkbox') row[f.name] = form.get(f.name) === 'on';
    saved = false;
  }
}

if (!setupError && !isNew && !error) {
  const { data, error: loadError } = await db().from(entity.table).select('*').eq('id', id).maybeSingle();
  if (!data) return new Response(loadError?.message ?? 'Not found', { status: 404 });
  row = data;
}
if (isNew && Object.keys(row).length === 0) {
  const appId = Astro.url.searchParams.get('app_id');
  row = { published: false, sort_order: 0, app_id: appId };
  // New entries go to the end of the list.
  if (!setupError && entity.key !== 'news') {
    let last = db().from(entity.table).select('sort_order').order('sort_order', { ascending: false }).limit(1);
    if (isChild && appId) last = last.eq('app_id', appId);
    const { data } = await last;
    row.sort_order = (data?.[0]?.sort_order ?? 0) + 1;
  }
}

const { data: apps } = setupError ? { data: [] } : await db().from('apps').select('id, name').order('sort_order');
// On an app's page: its features and plans.
const children =
  entity.key === 'apps' && !isNew && !setupError
    ? await Promise.all(
        APP_CHILDREN.map(async (child) => ({
          entity: child,
          rows: (await db().from(child.table).select('*').eq('app_id', id).order('sort_order')).data ?? [],
        })),
      )
    : [];

const title = isNew ? `${entity.singular} anlegen` : String(row[entity.titleField] || entity.singular);
const parentApp = isChild ? apps?.find((a) => a.id === row.app_id) : undefined;
---

<DashboardLayout title={title}>
  <p class="crumbs">
    {
      isChild ? (
        <>
          <a href={back ?? (parentApp ? `/apps/${parentApp.id}` : `/${entity.key}/`)}>← {back || !parentApp ? entity.label : parentApp.name}</a>
          {parentApp && (back ? <a class="crumb-alt" href={`/apps/${parentApp.id}`}>App „{parentApp.name}“ öffnen</a> : <a class="crumb-alt" href={`/${entity.key}/`}>Alle {entity.label}</a>)}
        </>
      ) : (
        <a href={`/${entity.key}/`}>← {entity.label}</a>
      )
    }
  </p>
  <div class="page-head">
    <h1>{title}</h1>
  </div>

  {saved && <p class="notice notice-ok">Gespeichert. Klicke auf „Website veröffentlichen“, damit die Änderung online geht.</p>}
  {error && <p class="notice notice-error">{error}</p>}

  {!setupError && <EntityForm entity={entity} row={row} apps={apps ?? []} isNew={isNew} />}

  {children.some((c) => c.rows.length > 1) && <div class="sort-wrap"><Sortable /></div>}
  {
    children.map(({ entity: child, rows }) => (
      <section class="panel children">
        <div class="page-head">
          <h2>{child.key === 'features' ? 'Funktionen & Screenshots' : child.label}</h2>
          <a class="btn" href={`/${child.key}/new?app_id=${id}`}>+ {child.singular} hinzufügen</a>
        </div>
        <ChildList entity={child} appId={id} rows={rows} />
      </section>
    ))
  }
</DashboardLayout>

<style>
  .crumbs { margin: 0 0 8px; display: flex; gap: 16px; flex-wrap: wrap; }
  .crumb-alt { color: var(--muted); }
  .children { margin-top: 24px; }
  .sort-wrap { margin-top: 24px; }
  .children .page-head { margin-bottom: 8px; }
</style>
