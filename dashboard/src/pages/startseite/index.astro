---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SortHandle from '../../components/SortHandle.astro';
import Sortable from '../../components/Sortable.astro';
import { configError, db, mediaPublicUrl } from '../../lib/server';
import { byHomeOrder } from '@lightning/shared';

const setupError = configError();
let error: string | null = setupError;
const notice = { saved: 'Gespeichert.', reset: 'Die Startseite folgt wieder der Reihenfolge der Apps.' }[Astro.url.searchParams.get('done') ?? ''];

type HomeApp = {
  id: string;
  name: string;
  icon_path: string | null;
  published: boolean;
  featured: boolean;
  show_on_home: boolean;
  sort_order: number;
  home_sort_order: number | null;
};
const load = async () =>
  ((await db().from('apps').select('id, name, icon_path, published, featured, show_on_home, sort_order, home_sort_order').eq('archived', false)).data ??
    []) as HomeApp[];

if (!setupError && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const reset = form.get('_action') === 'reset';
  const featuredId = String(form.get('featured') ?? '');
  const shown = new Set(form.getAll('show').map(String));
  const order = form.getAll('order').map(String);
  try {
    const apps = await load();
    const appOrder = [...apps].sort((a, b) => a.sort_order - b.sort_order).map((a) => a.id);
    // An own order is only stored once it differs from the apps list (or one exists already).
    const ownOrder = !reset && (apps.some((a) => a.home_sort_order !== null) || order.join() !== appOrder.join());
    const position = (id: string) => (ownOrder && order.includes(id) ? order.indexOf(id) + 1 : null);
    // Only touch rows that actually change, so untouched apps don't show up as changes.
    const updates = apps
      .map((app) => ({
        app,
        values: reset
          ? { home_sort_order: null }
          : { featured: app.id === featuredId, show_on_home: shown.has(app.id), home_sort_order: position(app.id) },
      }))
      .filter(({ app, values }) => Object.entries(values).some(([k, v]) => app[k as keyof HomeApp] !== v));
    // Unfeature first: at most one app may be featured at any time.
    updates.sort((a, b) => Number('featured' in a.values && a.values.featured) - Number('featured' in b.values && b.values.featured));
    for (const { app, values } of updates) {
      const { error: saveError } = await db().from('apps').update(values).eq('id', app.id);
      if (saveError) throw new Error(saveError.message);
    }
    return Astro.redirect(`/startseite/?done=${reset ? 'reset' : 'saved'}`, 303);
  } catch (e) {
    error = (e as Error).message;
  }
}

const apps = setupError ? [] : (await load()).sort(byHomeOrder);
const featured = apps.find((a) => a.featured);
const hasOwnOrder = apps.some((a) => a.home_sort_order !== null);
---

<DashboardLayout title="Startseite">
  <div class="page-head">
    <h1>Startseite</h1>
  </div>

  {notice && <p class="notice notice-ok">{notice} Klicke auf „Website veröffentlichen“, damit die Änderung online geht.</p>}
  {error && <p class="notice notice-error">{error}</p>}

  {
    !setupError && (
      <form method="post" class="stack">
        <section class="panel">
          <h2>Präsentierte App</h2>
          <p class="muted hint">Erscheint groß ganz oben auf der Startseite.</p>
          <select name="featured" class="select">
            <option value="" selected={!featured}>Automatisch (erste App in der Liste unten)</option>
            {apps.map((app) => (
              <option value={app.id} selected={app.id === featured?.id}>
                {app.name}
                {app.published ? '' : ' (Entwurf)'}
              </option>
            ))}
          </select>
        </section>

        <section class="panel">
          <div class="list-head">
            <h2>Apps auf der Startseite</h2>
            {hasOwnOrder ? (
              <button
                class="btn"
                type="submit"
                name="_action"
                value="reset"
                data-confirm="Eigene Reihenfolge verwerfen und die Reihenfolge der Apps übernehmen?"
              >
                Reihenfolge der Apps übernehmen
              </button>
            ) : (
              <span class="muted order-state">Reihenfolge wie unter Apps</span>
            )}
          </div>
          <p class="muted hint">
            Ziehe die Apps in die Reihenfolge, in der sie auf der Startseite erscheinen sollen. Ausgeschaltete Apps bleiben in der Navigation und unter
            „Alle Apps“ erreichbar, archivierte Apps stehen nie auf der Startseite.
          </p>
          {apps.length === 0 ? (
            <p class="muted">Noch keine Apps.</p>
          ) : (
            <>
              {apps.length > 1 && <Sortable />}
              <table>
                <tbody data-sortable="apps" data-sort-save="form">
                  {apps.map((app) => {
                    const icon = mediaPublicUrl(app.icon_path);
                    return (
                      <tr data-id={app.id}>
                        <td class="sort-cell">
                          <SortHandle title={app.name} />
                          <input type="hidden" name="order" value={app.id} />
                        </td>
                        <td class="icon-cell">{icon ? <img class="thumb" src={icon} alt="" /> : <span class="thumb" />}</td>
                        <td>
                          <span class="home-name">
                            <strong>{app.name}</strong>
                            {!app.published && <span class="pill pill-draft">Entwurf</span>}
                          </span>
                        </td>
                        <td class="switch-cell">
                          <input
                            class="switch"
                            type="checkbox"
                            name="show"
                            value={app.id}
                            checked={app.show_on_home}
                            aria-label={`${app.name} auf der Startseite zeigen`}
                          />
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </>
          )}
        </section>

        <div>
          <button class="btn btn-primary" type="submit">Speichern</button>
        </div>
      </form>
    )
  }
</DashboardLayout>

<style>
  .hint { margin: -6px 0 14px; }
  .list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .list-head h2 { margin: 0; }
  .order-state { font-size: 13px; }
  .select { font: inherit; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); min-width: min(100%, 360px); }
  .icon-cell { width: 1%; padding-right: 0; }
  .icon-cell .thumb { display: block; }
  .home-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .switch-cell { width: 1%; text-align: right; }
  .switch { appearance: none; display: block; width: 42px; height: 26px; margin: 0; border-radius: 13px; background: var(--border); position: relative; cursor: pointer; transition: background 0.2s; }
  .switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.25); transition: transform 0.2s; }
  .switch:checked { background: var(--ok); }
  .switch:checked::after { transform: translateX(16px); }
  .switch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
