---
import { LOCALES, type Platform } from '@lightning/shared';
import { PLATFORM_NAMES, PLATFORM_STATES, PLATFORM_STATE_LABELS, type Entity, type Field } from '../lib/entities';
import { mediaPublicUrl } from '../lib/server';

interface Props {
  entity: Entity;
  row: Record<string, any>;
  apps: { id: string; name: string }[];
  isNew: boolean;
}
const { entity, row, apps, isNew } = Astro.props;
const LANG_LABEL = { de: 'Deutsch', en: 'English' } as const;
const hasI18n = entity.fields.some((f) => f.i18n);

function columns(field: Field) {
  return field.i18n ? LOCALES.map((lang) => ({ column: `${field.name}_${lang}`, lang })) : [{ column: field.name, lang: null }];
}
const platforms = (row.platforms ?? []) as Platform[];
---

<form method="post" enctype="multipart/form-data" class="entity-form stack">

  {
    hasI18n && (
      <div class="lang-tabs" role="tablist" aria-label="Sprache">
        {LOCALES.map((lang, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-lang-tab={lang}>
            {LANG_LABEL[lang]}
            {lang !== 'de' && <span class="empty-count" data-empty-count hidden></span>}
          </button>
        ))}
        <span class="muted lang-hint">Felder mit 🌐 gibt es pro Sprache. Leere englische Felder zeigen den deutschen Text als Platzhalter und fallen auf der Website auf Deutsch zurück.</span>
      </div>
    )
  }

  <div class="panel fields">
    {
      entity.fields.filter((field) => !field.formHidden).map((field) =>
        columns(field).map(({ column, lang }) => {
          const value = row[column];
          const id = `f-${column}`;
          // Translations: the German text is the placeholder and can be copied over.
          const translatable = lang !== null && lang !== 'de' && ['text', 'textarea', 'markdown'].includes(field.type);
          const source = translatable ? `f-${field.name}_de` : undefined;
          const placeholder = translatable ? String(row[`${field.name}_de`] ?? '') : undefined;
          const label = (
            <div class="field-label-row">
              <label for={id} class="field-label">
                {field.label}
                {lang && <span class="lang-tag">🌐 {lang.toUpperCase()}</span>}
                {field.required && <span class="req">*</span>}
              </label>
              {translatable && <button type="button" class="copy-de" data-copy-from={source} data-copy-to={id}>Aus Deutsch übernehmen</button>}
            </div>
          );
          const wrapClass = ['field', `field-${field.type}`, lang ? `lang-field lang-${lang}` : '', lang && lang !== 'de' ? 'is-hidden' : ''];
          return (
            <div class:list={wrapClass}>
              {field.type === 'section' ? (
                <h3 class="field-section">{field.label}</h3>
              ) : field.type === 'checkbox' ? (
                <label class="check">
                  <input type="checkbox" id={id} name={column} checked={Boolean(value)} />
                  <span>{field.label}</span>
                </label>
              ) : (
                label
              )}

              {field.type === 'text' && <input id={id} name={column} type="text" value={value ?? ''} required={field.required && lang !== 'en'} pattern={field.name === 'slug' ? '[a-z0-9-]+' : undefined} placeholder={placeholder} data-translation-of={source} />}
              {field.type === 'url' && <input id={id} name={column} type="url" value={value ?? ''} placeholder="https://" />}
              {field.type === 'number' && <input id={id} name={column} type="number" value={value ?? 0} step="1" />}
              {field.type === 'price' && (
                <div class="price-row">
                  <input id={id} name={column} type="text" inputmode="decimal" value={value === null || value === undefined ? '' : String(value).replace('.', ',')} required={field.required} pattern="\s*\d+([.,]\d{1,2})?\s*(€)?\s*" placeholder="z. B. 4,99" />
                  <span class="muted">€</span>
                </div>
              )}
              {field.type === 'count' && <input id={id} name={column} type="number" value={value ?? ''} min="1" step="1" />}
              {field.type === 'year' && <input id={id} name={column} type="number" value={value ?? ''} min="1990" max="2100" step="1" placeholder="z. B. 2021" />}
              {field.type === 'date' && <input id={id} name={column} type="date" value={value ?? new Date().toISOString().slice(0, 10)} required={field.required} />}
              {field.type === 'color' && (
                <div class="color-row">
                  <input id={id} name={column} type="color" value={value || '#0071e3'} />
                  <code>{value || '#0071e3'}</code>
                </div>
              )}
              {field.type === 'textarea' && <textarea id={id} name={column} rows="3" placeholder={placeholder} data-translation-of={source}>{value ?? ''}</textarea>}
              {field.type === 'select' && (
                <select id={id} name={column}>
                  {field.options?.map((o) => <option value={o.value} selected={value === o.value}>{o.label}</option>)}
                </select>
              )}
              {field.type === 'app' && (
                <select id={id} name={column} required={field.required}>
                  {!field.required && <option value="">– keine –</option>}
                  {apps.map((a) => <option value={a.id} selected={value === a.id}>{a.name}</option>)}
                </select>
              )}
              {field.type === 'markdown' && (
                <div class="md" data-markdown>
                  <textarea id={id} name={column} rows="14" data-md-input placeholder={placeholder} data-translation-of={source}>{value ?? ''}</textarea>
                  <div class="md-preview" data-md-preview aria-label="Vorschau"></div>
                </div>
              )}
              {field.type === 'image' && (
                <div class="image-field">
                  {value && <img src={mediaPublicUrl(value)} alt="" class="image-preview" />}
                  <div class="image-controls">
                    <input id={id} name={`${column}__file`} type="file" accept="image/*" />
                    {value && (
                      <label class="check small">
                        <input type="checkbox" name={`${column}__remove`} /> Bild entfernen
                      </label>
                    )}
                  </div>
                </div>
              )}
              {field.type === 'platforms' && (
                <div class="platforms">
                  {PLATFORM_NAMES.map((name) => {
                    const current = platforms.find((p) => p.name === name);
                    return (
                      <div class="platform">
                        <label class="check">
                          <input type="checkbox" name={`platform_${name}`} checked={Boolean(current)} />
                          <span>{name}</span>
                        </label>
                        <select name={`platform_${name}_state`} aria-label={`Status ${name}`}>
                          {PLATFORM_STATES.map((s) => <option value={s} selected={(current?.state ?? 'planned') === s}>{PLATFORM_STATE_LABELS[s]}</option>)}
                        </select>
                      </div>
                    );
                  })}
                </div>
              )}

              {field.help && <p class="help">{field.help}</p>}
            </div>
          );
        }),
      )
    }
  </div>

  <div class="form-actions">
    <!-- The clicked button decides the action; Enter in a field uses this first button. -->
    <button class="btn btn-primary" type="submit" name="_action" value="save">{isNew ? `${entity.singular} anlegen` : 'Speichern'}</button>
    {
      !isNew && (
        <button class="btn btn-danger" type="submit" name="_action" value="delete" formnovalidate data-confirm={`${entity.singular} wirklich endgültig löschen?`}>
          Löschen
        </button>
      )
    }
  </div>
</form>

<script>
  import { marked } from 'marked';

  // Language tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-lang-tab]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const lang = tab.dataset.langTab;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('.lang-field').forEach((el) => {
        el.classList.toggle('is-hidden', !el.classList.contains(`lang-${lang}`));
      });
    }),
  );

  // A required field on the hidden language tab: switch to that tab so the browser can show the error.
  document.querySelector('.entity-form')?.addEventListener(
    'invalid',
    (e) => {
      const field = (e.target as HTMLElement).closest<HTMLElement>('.lang-field.is-hidden');
      const lang = field?.className.match(/lang-(de|en)/)?.[1];
      if (lang) document.querySelector<HTMLButtonElement>(`[data-lang-tab="${lang}"]`)?.click();
    },
    true,
  );

  // Translations: German text as placeholder, copy button, and a count of empty English fields on the tab.
  const translations = [...document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-translation-of]')];
  const sourceOf = (el: HTMLElement) => document.getElementById(el.dataset.translationOf!) as HTMLInputElement | HTMLTextAreaElement | null;
  const emptyCount = document.querySelector<HTMLElement>('[data-empty-count]');
  function updateTranslations() {
    let empty = 0;
    for (const el of translations) {
      const german = sourceOf(el)?.value ?? '';
      el.placeholder = german;
      if (!el.value.trim() && german.trim()) empty++;
      const copy = document.querySelector<HTMLButtonElement>(`[data-copy-to="${el.id}"]`);
      if (copy) copy.disabled = !german.trim() || el.value === german;
    }
    if (emptyCount) {
      emptyCount.hidden = empty === 0;
      emptyCount.textContent = `${empty} leer`;
    }
  }
  translations.forEach((el) => {
    el.addEventListener('input', updateTranslations);
    sourceOf(el)?.addEventListener('input', updateTranslations);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy-from]').forEach((button) =>
    button.addEventListener('click', () => {
      const from = document.getElementById(button.dataset.copyFrom!) as HTMLInputElement | null;
      const to = document.getElementById(button.dataset.copyTo!) as HTMLInputElement | null;
      if (!from || !to) return;
      to.value = from.value;
      to.dispatchEvent(new Event('input', { bubbles: true }));
      to.focus();
    }),
  );
  updateTranslations();

  // Live Markdown preview (content is written by you, so rendering it as HTML is fine)
  document.querySelectorAll<HTMLElement>('[data-markdown]').forEach((wrap) => {
    const input = wrap.querySelector<HTMLTextAreaElement>('[data-md-input]')!;
    const preview = wrap.querySelector<HTMLElement>('[data-md-preview]')!;
    const render = () => (preview.innerHTML = marked.parse(input.value || '*Vorschau*', { async: false }));
    input.addEventListener('input', render);
    render();
  });

  // Keep the color code next to the picker in sync
  document.querySelectorAll<HTMLInputElement>('input[type="color"]').forEach((input) =>
    input.addEventListener('input', () => {
      const code = input.nextElementSibling;
      if (code) code.textContent = input.value;
    }),
  );
</script>

<style>
  .lang-tabs { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .lang-tabs button {
    padding: 6px 14px;
    border-radius: 980px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .lang-tabs button[aria-selected='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .lang-hint { font-size: 12px; margin-left: 8px; }

  .fields { display: grid; gap: 20px; }
  .field { display: grid; gap: 6px; }
  .field.is-hidden { display: none; }
  .field-section { margin: 12px 0 0; padding-top: 20px; border-top: 1px solid var(--border); font-size: 17px; }
  .field-label { font-weight: 600; display: flex; gap: 8px; align-items: center; }
  .field-label-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .copy-de {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 980px;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
  }
  .copy-de:hover:not(:disabled) { border-color: var(--accent); }
  .copy-de:disabled { color: var(--muted); cursor: default; opacity: 0.6; }
  .empty-count { margin-left: 6px; padding: 1px 7px; border-radius: 980px; background: color-mix(in srgb, var(--warn) 18%, transparent); color: var(--warn); font-size: 11px; font-weight: 600; }
  .empty-count[hidden] { display: none; }
  .lang-tabs button[aria-selected='true'] .empty-count { background: var(--warn); color: var(--bg); }
  ::placeholder { color: color-mix(in srgb, var(--muted) 75%, transparent); }
  .lang-tag { font-size: 11px; font-weight: 600; color: var(--muted); }
  .req { color: var(--danger); }
  .help { margin: 0; color: var(--muted); font-size: 12px; }

  input[type='text'], input[type='url'], input[type='number'], input[type='date'], textarea, select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }
  input[type='number'] { max-width: 120px; }
  .price-row { display: flex; align-items: center; gap: 8px; }
  .price-row input { max-width: 140px; }
  input[type='date'], select { max-width: 280px; }
  textarea { resize: vertical; line-height: 1.5; }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }

  .check { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer; }
  .check.small { font-weight: 400; font-size: 12px; }
  .color-row { display: flex; align-items: center; gap: 10px; }
  .color-row input { width: 44px; height: 32px; padding: 0; border: 0; background: none; }

  .md { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .md textarea { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13px; min-height: 280px; }
  .md-preview {
    padding: 4px 16px;
    border: 1px dashed var(--border);
    border-radius: 8px;
    font-size: 15px;
    line-height: 1.55;
    overflow: auto;
    max-height: 520px;
  }
  .md-preview :global(img) { max-width: 100%; }
  @media (max-width: 1000px) { .md { grid-template-columns: 1fr; } }

  .image-field { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .image-preview { width: 96px; height: 96px; object-fit: cover; border-radius: 14px; border: 1px solid var(--border); }
  .image-controls { display: grid; gap: 8px; }

  .platforms { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .platform { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; }
  .platform select { width: auto; padding: 4px 6px; font-size: 12px; }

  .form-actions { display: flex; gap: 10px; }
</style>
