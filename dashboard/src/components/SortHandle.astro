---
// Drag handle plus up/down buttons for one row of a sortable table.
// The table body needs data-sortable (see Sortable.astro); the row needs data-id.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="sort-controls">
  <button type="button" class="drag-handle" data-drag-handle aria-label={`${title} verschieben (Pfeiltasten)`} title="Ziehen oder Pfeiltasten ↑ ↓">
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <circle cx="4.5" cy="3" r="1.3"></circle><circle cx="9.5" cy="3" r="1.3"></circle>
      <circle cx="4.5" cy="7" r="1.3"></circle><circle cx="9.5" cy="7" r="1.3"></circle>
      <circle cx="4.5" cy="11" r="1.3"></circle><circle cx="9.5" cy="11" r="1.3"></circle>
    </svg>
  </button>
  <span class="step-buttons">
    <button type="button" data-move="up" aria-label={`${title} nach oben`} title="Nach oben">
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 6.5 5 3.5l3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button type="button" data-move="down" aria-label={`${title} nach unten`} title="Nach unten">
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </span>
</div>

<style>
  .sort-controls { display: flex; align-items: center; gap: 2px; }
  .drag-handle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    fill: currentColor;
    cursor: grab;
    touch-action: none;
  }
  .drag-handle:hover, .drag-handle:focus-visible { background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--text); }
  .drag-handle:focus-visible { outline: 2px solid var(--accent); }
  .step-buttons { display: grid; }
  .step-buttons button {
    display: grid;
    place-items: center;
    width: 20px;
    height: 16px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .step-buttons button:hover { background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--text); }
</style>
