---
import { ENTITIES } from '../lib/entities';
import { authRequired } from '../lib/auth';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Übersicht' },
  ...Object.values(ENTITIES)
    .filter((e) => !e.nested)
    .map((e) => ({ href: `/${e.key}/`, label: e.label })),
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href) || (href === '/apps/' && path.startsWith('/features/')));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} – Lightning Apps Dashboard</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231d1d1f'/%3E%3Cpath fill='%23fff' d='M18 4.5 7.5 18h7l-1.5 9.5L24.5 13.5h-7.1L18 4.5Z'/%3E%3C/svg%3E" />
  </head>
  <body>
    <aside class="sidebar">
      <a class="brand" href="/">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 1.5 4 13.6h6.3L9 22.5l10-12.6h-6.4l.9-8.4Z"></path></svg>
        <span>Lightning Apps</span>
      </a>
      <p class="brand-sub">Dashboard · lokal</p>
      <nav>
        {nav.map((item) => <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>)}
      </nav>
      <form method="post" action="/api/deploy" class="deploy-form" data-confirm="Alle offenen Änderungen veröffentlichen und die Website neu bauen?">
        <button class="btn btn-primary btn-block" type="submit">Website veröffentlichen</button>
      </form>
      {
        authRequired() && (
          <form method="post" action="/logout">
            <button class="btn btn-block" type="submit">Abmelden</button>
          </form>
        )
      }
    </aside>
    <main class="main">
      <slot />
    </main>

    <script>
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        const submitter = (e as SubmitEvent).submitter as HTMLElement | null;
        const message = submitter?.dataset.confirm ?? form.dataset.confirm;
        if (message && !window.confirm(message)) e.preventDefault();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', 'Helvetica Neue', sans-serif;
    --bg: #f5f5f7;
    --panel: #ffffff;
    --text: #1d1d1f;
    --muted: #6e6e73;
    --border: #d2d2d7;
    --accent: #0071e3;
    --danger: #e30000;
    --ok: #1a8f3a;
    --warn: #b25e00;
    --radius: 12px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --panel: #1c1c1e;
      --text: #f5f5f7;
      --muted: #a1a1a6;
      --border: #38383a;
      --accent: #0a84ff;
      --danger: #ff453a;
      --ok: #30d158;
      --warn: #ffb340;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
    font-family: var(--font);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { font-size: 28px; letter-spacing: -0.02em; margin: 0; }
  h2 { font-size: 17px; margin: 0 0 12px; }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 14px;
    background: var(--panel);
    border-right: 1px solid var(--border);
  }
  .brand { display: flex; align-items: center; gap: 6px; padding: 0 10px; color: var(--text); font-size: 16px; font-weight: 600; }
  .brand:hover { text-decoration: none; }
  .brand-sub { margin: 0 0 16px; padding: 0 10px; color: var(--muted); font-size: 12px; }
  .sidebar nav { display: grid; gap: 2px; }
  .sidebar nav a { padding: 8px 10px; border-radius: 8px; color: var(--text); font-weight: 500; }
  .sidebar nav a:hover { background: color-mix(in srgb, var(--text) 6%, transparent); text-decoration: none; }
  .sidebar nav a.active { background: var(--accent); color: #fff; }
  .deploy-form { margin-top: auto; margin-bottom: 6px; }

  .main { padding: 32px 40px 64px; max-width: 1100px; width: 100%; }
  .page-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .panel { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
  .stack { display: grid; gap: 20px; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 34px;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .btn:hover { text-decoration: none; border-color: var(--muted); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { filter: brightness(1.08); border-color: var(--accent); }
  .btn-danger { color: var(--danger); }
  .btn-block { width: 100%; }

  .notice { padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-weight: 500; }
  .notice-ok { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
  .notice-error { background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); }
  .notice-warn { background: color-mix(in srgb, var(--warn) 14%, transparent); color: var(--warn); }

  .pill { display: inline-block; padding: 2px 8px; border-radius: 980px; font-size: 12px; font-weight: 600; }
  .pill-published { background: color-mix(in srgb, var(--ok) 15%, transparent); color: var(--ok); }
  .pill-draft { background: color-mix(in srgb, var(--muted) 18%, transparent); color: var(--muted); }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  th { font-size: 12px; color: var(--muted); font-weight: 600; }
  tr:last-child td { border-bottom: 0; }
  .thumb { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; background: var(--bg); }
  .muted { color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

  @media (max-width: 800px) {
    body { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; }
    .main { padding: 24px 16px; }
  }
</style>
